#!/bin/bash
# AlpacaBridge software update helper (docs/software-update.md).
#
# Runs as root under alpacabridge-update.service, which the daemon starts over
# D-Bus when the operator clicks "Install Update" in the web UI. It upgrades
# the one package this host already has installed from the apt sources the
# host already trusts; nothing here is parameterised by the daemon.
#
# The transcript goes to /var/log/AlpacaBridge/update.log (world-readable, so
# the non-root daemon can show it) and ends with one of two markers the daemon
# parses:
#   === RESULT: success ...
#   === RESULT: failure ...
# A transcript without a marker means the run was killed or the host rebooted
# mid-upgrade. The daemon's log directory is /var/log/AlpacaBridge under the
# packaged service; keep LOG in step with logging.directory if that ever moves.

set -u

PACKAGE=alpacabridge
LOG=/var/log/AlpacaBridge/update.log
APT_OPTS=(-y -o DPkg::Lock::Timeout=120 -o Dpkg::Options::=--force-confold)

export DEBIAN_FRONTEND=noninteractive

mkdir -p "$(dirname "$LOG")"
: > "$LOG"
chmod 0644 "$LOG"
exec >>"$LOG" 2>&1

stamp() { date -u +%Y-%m-%dT%H:%M:%SZ; }

echo "=== AlpacaBridge software update started $(stamp)"
echo "=== installed: $(dpkg-query -W -f='${Version}' "$PACKAGE" 2>/dev/null || echo unknown)"

# Refresh the package lists. A failing unrelated source prints a warning and
# apt-get still returns 0; a hard failure (an unsigned or unreachable
# OpenAstro source) is reported by the install step below, so the update's
# exit status is logged but not fatal on its own.
echo "=== apt-get update"
apt-get update -o DPkg::Lock::Timeout=120
echo "=== apt-get update exit $?"

echo "=== apt-get install --only-upgrade $PACKAGE"
apt-get install --only-upgrade "${APT_OPTS[@]}" "$PACKAGE"
rc=$?

installed="$(dpkg-query -W -f='${Version}' "$PACKAGE" 2>/dev/null || echo unknown)"
if [ "$rc" -eq 0 ]; then
    echo "=== RESULT: success $(stamp) installed $installed"
else
    echo "=== RESULT: failure $(stamp) exit $rc installed $installed"
fi
exit "$rc"
